---
import Base from '../layouts/Base.astro';
// Placeholder home page (Story 1). Real hero + landing content arrives in Story 3–4.
const tagline =
  'Five lines a day. No account. No cloud. Your gratitude stays on your phone.';
---

<Base
  title="Munin — coming soon"
  description="Munin is a private, minimalist daily gratitude journal for iPhone. No account, no cloud — your notes stay on your device."
  lang="en"
  noindex
>
  <main class="home">
    <div class="hero">
      <p class="kicker">Munin: Gratitude Journal</p>
      <h1>Munin</h1>
      <p class="tagline">{tagline}</p>
      <p class="soon">Website coming soon.</p>
    </div>
    <footer class="foot">
      <a href="/privacy">Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href="/integritetspolicy">Integritetspolicy</a>
    </footer>
  </main>

  <style>
    .home {
      min-height: 100vh;
      display: grid;
      grid-template-rows: 1fr auto;
      padding: 24px;
      text-align: center;
    }
    .hero {
      align-self: center;
      max-width: 34rem;
      margin: 0 auto;
    }
    .kicker {
      margin: 0 0 0.75rem;
      font-size: 0.8rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
    }
    h1 {
      margin: 0;
      font-size: clamp(2.75rem, 8vw, 4.5rem);
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .tagline {
      margin: 1.25rem auto 0;
      font-size: clamp(1.05rem, 2.6vw, 1.35rem);
      color: var(--ink);
    }
    .soon {
      margin-top: 2.5rem;
      font-size: 0.95rem;
      color: var(--muted);
    }
    .foot {
      padding: 1.5rem 0 0.5rem;
      font-size: 0.85rem;
      color: var(--muted);
      display: flex;
      gap: 0.6rem;
      justify-content: center;
      align-items: center;
    }
    .foot a {
      color: var(--muted);
      text-decoration: none;
    }
    .foot a:hover {
      color: var(--ink);
      text-decoration: underline;
    }
  </style>
</Base>
