---
// Placeholder home page for Story 1 (project skeleton).
// Real hero + landing content arrives in Story 3–4.
// UI copy on this site is intentionally kept in the page for now; a shared
// EN/SV string setup is introduced in Story 5 (language switch).
const tagline = 'Five lines a day. No account. No cloud. Your gratitude stays on your phone.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Munin — coming soon</title>
    <meta
      name="description"
      content="Munin is a private, minimalist daily gratitude journal for iPhone. No account, no cloud — your notes stay on your device."
    />
  </head>
  <body>
    <main>
      <p class="kicker">Munin: Gratitude Journal</p>
      <h1>Munin</h1>
      <p class="tagline">{tagline}</p>
      <p class="soon">Website coming soon.</p>
    </main>

    <style>
      :root {
        color-scheme: dark;
        --bg: #14171f;
        --ink: #f4f1e8;
        --muted: #9aa0ad;
        --gold: #d4af37;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial,
          sans-serif;
        display: grid;
        place-items: center;
        padding: 24px;
        text-align: center;
      }
      main {
        max-width: 34rem;
      }
      .kicker {
        margin: 0 0 0.75rem;
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gold);
      }
      h1 {
        margin: 0;
        font-size: clamp(2.75rem, 8vw, 4.5rem);
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .tagline {
        margin: 1.25rem auto 0;
        font-size: clamp(1.05rem, 2.6vw, 1.35rem);
        line-height: 1.5;
        color: var(--ink);
      }
      .soon {
        margin-top: 2.5rem;
        font-size: 0.95rem;
        color: var(--muted);
      }
    </style>
  </body>
</html>
