---
import { Image } from 'astro:assets';
import Features from './Features.astro';
import Story from './Story.astro';
import Faq from './Faq.astro';
import { appStoreUrl, type LandingContent } from '../data/site';
// The Munin app icon (gold feather on dark ground), shared with the iOS app.
import appIcon from '../assets/app-icon.png';

interface Props {
  content: LandingContent;
}
const { content } = Astro.props;
---

<main class="home">
  <div class="topbar">
    <a href={content.langSwitchHref} rel="alternate">{content.langSwitchLabel}</a>
  </div>

  <section class="hero">
    <div class="icon-wrap">
      <Image
        src={appIcon}
        alt="Munin app icon"
        width={224}
        height={224}
        class="app-icon"
        loading="eager"
      />
    </div>

    <p class="kicker">{content.kicker}</p>
    <h1>{content.name}</h1>
    <p class="tagline">{content.tagline}</p>

    <div class="cta">
      {
        appStoreUrl ? (
          <a class="store-btn" href={appStoreUrl}>
            {content.storeCta}
          </a>
        ) : (
          <span class="store-soon">{content.storeSoon}</span>
        )
      }
    </div>

    <ul class="chips" aria-label="Highlights">
      {content.chips.map((chip) => <li>{chip}</li>)}
    </ul>
  </section>

  <Features features={content.features} />

  <Story story={content.story} />

  <Faq heading={content.faqHeading} items={content.faq} />

  <footer class="foot">
    <a href={content.privacyHref}>{content.privacyLabel}</a>
  </footer>
</main>

<style>
  .home {
    padding: 24px;
  }
  .topbar {
    max-width: 56rem;
    margin: 0 auto;
    display: flex;
    justify-content: flex-end;
  }
  .topbar a {
    color: var(--gold);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .topbar a:hover {
    text-decoration: underline;
  }
  .hero {
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
  }
  .icon-wrap {
    position: relative;
    width: 112px;
    height: 112px;
    margin: 0 auto 1.75rem;
  }
  .icon-wrap::before {
    content: '';
    position: absolute;
    inset: -28%;
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.28),
      rgba(212, 175, 55, 0) 70%
    );
    z-index: 0;
  }
  .app-icon {
    position: relative;
    z-index: 1;
    width: 112px;
    height: 112px;
    border-radius: 24px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  .kicker {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .tagline {
    margin: 1.25rem auto 0;
    max-width: 30rem;
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    color: var(--ink);
  }
  .cta {
    margin-top: 2rem;
  }
  .store-btn {
    display: inline-block;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }
  .store-btn:hover {
    opacity: 0.9;
  }
  .store-soon {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    border: 1px solid rgba(212, 175, 55, 0.5);
    color: var(--gold);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .chips {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    justify-content: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .chips li {
    position: relative;
  }
  .chips li + li::before {
    content: '·';
    position: absolute;
    left: -0.75rem;
  }
  .foot {
    padding: 4rem 0 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    align-items: center;
  }
  .foot a {
    color: var(--muted);
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
