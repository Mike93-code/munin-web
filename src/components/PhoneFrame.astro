---
// A phone-shaped placeholder for an app screenshot. Each variant draws a light,
// on-brand motif hinting at the real screen. When real screenshots are ready,
// this component can take an image instead of the motif (Story: screenshots).
interface Props {
  screenName: string;
  variant: 'lines' | 'streak' | 'calendar' | 'privacy';
  /** Localized caption inside the streak / privacy motifs. */
  note?: string;
}
const { screenName, variant, note } = Astro.props;
const streakNote = note ?? 'day streak';
const privacyNote = note ?? 'On your device';
const romans = ['i', 'ii', 'iii', 'iv', 'v'];
// 28 cells for a mini month grid; a few marked as "filled".
const days = Array.from({ length: 28 }, (_, i) => i);
const filled = new Set([2, 3, 4, 8, 9, 10, 11, 15, 16, 17, 22, 23, 24, 25]);
---

<div class="phone" role="img" aria-label={`Placeholder preview of the ${screenName} screen`}>
  <span class="notch" aria-hidden="true"></span>
  <div class="screen">
    <div class="motif">
      {
        variant === 'lines' && (
          <ul class="lines">
            {romans.map((r) => (
              <li>
                <span class="roman">{r}</span>
                <span class="bar" />
              </li>
            ))}
          </ul>
        )
      }
      {
        variant === 'streak' && (
          <div class="streak">
            <svg viewBox="0 0 24 24" width="44" height="44" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2c1 3-1 4-2 6-1-1-1-2-1-3-2 2-4 4-4 8a7 7 0 0 0 14 0c0-3-2-5-3-7-1 2-2 3-3 3 1-3 3-5 2-7z"
              />
            </svg>
            <span class="big">12</span>
            <span class="small">{streakNote}</span>
          </div>
        )
      }
      {
        variant === 'calendar' && (
          <div class="cal">
            {days.map((d) => (
              <span class={filled.has(d) ? 'cell on' : 'cell'} />
            ))}
          </div>
        )
      }
      {
        variant === 'privacy' && (
          <div class="privacy">
            <svg viewBox="0 0 24 24" width="46" height="46" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                d="M7 10V7a5 5 0 0 1 10 0v3"
              />
              <rect
                x="5"
                y="10"
                width="14"
                height="10"
                rx="2"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              />
              <circle cx="12" cy="15" r="1.4" fill="currentColor" />
            </svg>
            <span class="small">{privacyNote}</span>
          </div>
        )
      }
    </div>
    <p class="screen-name">{screenName}</p>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 200px;
    aspect-ratio: 200 / 410;
    margin: 0 auto;
    border-radius: 32px;
    padding: 10px;
    background: linear-gradient(160deg, #2a2f3d, #171b24);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1px rgba(244, 241, 232, 0.06);
  }
  .notch {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: 74px;
    height: 18px;
    border-radius: 0 0 12px 12px;
    background: #0d0f15;
    z-index: 2;
  }
  .screen {
    height: 100%;
    border-radius: 24px;
    background: radial-gradient(120% 80% at 50% 0%, #1d222e, var(--bg));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 2.25rem 1.1rem 1.5rem;
    overflow: hidden;
  }
  .motif {
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 130px;
    width: 100%;
  }
  .screen-name {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* lines (Idag) */
  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: 0.6rem;
  }
  .lines li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .roman {
    width: 1.4rem;
    text-align: right;
    font-size: 0.7rem;
    color: var(--gold);
  }
  .bar {
    flex: 1;
    height: 7px;
    border-radius: 4px;
    background: rgba(244, 241, 232, 0.12);
  }
  .lines li:nth-child(-n + 3) .bar {
    background: rgba(212, 175, 55, 0.4);
  }

  /* streak */
  .streak {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }
  .streak .big {
    font-size: 2.4rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.1;
  }
  .streak .small,
  .privacy .small {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* calendar */
  .cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
    width: 100%;
    max-width: 150px;
  }
  .cell {
    aspect-ratio: 1;
    border-radius: 3px;
    background: rgba(244, 241, 232, 0.1);
  }
  .cell.on {
    background: rgba(212, 175, 55, 0.55);
  }

  /* privacy */
  .privacy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
</style>
