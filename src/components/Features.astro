---
import PhoneFrame from './PhoneFrame.astro';
import type { Feature } from '../data/site';

interface Props {
  features: Feature[];
}
const { features } = Astro.props;
---

<section class="features" aria-label="Features">
  {
    features.map((f, i) => (
      <article class={i % 2 === 1 ? 'row reverse' : 'row'}>
        <div class="art">
          <PhoneFrame variant={f.variant} screenName={f.screenName} note={f.note} />
        </div>
        <div class="copy">
          <h2>{f.title}</h2>
          <p>{f.body}</p>
        </div>
      </article>
    ))
  }
</section>

<style>
  .features {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: grid;
    gap: 4.5rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2.5rem;
  }
  .art {
    display: flex;
    justify-content: center;
  }
  .copy h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 600;
  }
  .copy p {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
    max-width: 32ch;
  }

  @media (max-width: 640px) {
    .row,
    .row.reverse {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      text-align: center;
    }
    .copy p {
      max-width: none;
    }
  }

  /* On wide screens every other row flips the phone to the right. */
  @media (min-width: 641px) {
    .row.reverse .art {
      order: 2;
    }
  }
</style>
