---
import type { FaqItem } from '../data/site';
interface Props {
  heading: string;
  items: FaqItem[];
}
const { heading, items } = Astro.props;
---

<section class="faq" aria-label={heading}>
  <div class="inner">
    <h2>{heading}</h2>
    <div class="list">
      {
        items.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <svg class="chev" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 3.5rem 1.25rem 0;
  }
  .inner {
    max-width: 44rem;
    margin: 0 auto;
  }
  h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--gold);
    text-align: center;
  }
  .list {
    display: grid;
    gap: 0.75rem;
  }
  details {
    border: 1px solid rgba(244, 241, 232, 0.12);
    border-radius: 12px;
    background: rgba(244, 241, 232, 0.02);
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--gold);
  }
  .chev {
    flex: none;
    color: var(--muted);
    transition: transform 0.2s ease;
  }
  details[open] .chev {
    transform: rotate(180deg);
    color: var(--gold);
  }
  details p {
    margin: 0;
    padding: 0 1.25rem 1.15rem;
    color: var(--muted);
    line-height: 1.65;
    font-size: 1rem;
  }
</style>
